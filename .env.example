APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_pmo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue Configuration
# Use 'database' with cron job on cPanel, or 'sync' for immediate execution
# On cPanel without cron: QUEUE_CONNECTION=sync
# On cPanel with cron: QUEUE_CONNECTION=database
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="pmo@universtelecom.com"
MAIL_FROM_NAME="PMO Groupe Univers Telecom"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Salesforce API Configuration
SALESFORCE_TOKEN_URL=https://universtelecom2022.my.salesforce.com/services/oauth2/token
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_BASE=https://universtelecom2022.my.salesforce.com
SALESFORCE_API_VERSION=v64.0

# Microsoft Graph API Configuration (MS Planner)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
MS_GRAPH_DEFAULT_GROUP_ID=
MS_GRAPH_AUTO_SYNC=false

# Employee API Configuration
API_EMMPLOYEE_URL=
API_EMPLOYEE=X-API-KEY
API_EMPLOYEE_KEY=
API_EMPLOYEE_TIMEOUT=15
API_EMPLOYEE_VERIFY_SSL=true

# GLPI API Configuration (Maintenance Projects)
GLPI_API_URL=https://infra.groupe-universtelecom.com/apirest.php
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_APP_TOKEN=
GLPI_VERIFY_SSL=false
GLPI_DEFAULT_ENTITY_ID=0
GLPI_DEFAULT_PROJECT_STATE_ID=1
GLPI_DEFAULT_PROJECT_TYPE_ID=1
GLPI_AUTO_SYNC=true
